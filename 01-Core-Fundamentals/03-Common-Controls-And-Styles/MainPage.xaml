<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiMastery.CommonControlsAndStyles.MainPage"
             Title="Базові елементи та стилі">
    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="16">
            <Label Text="Реєстраційна форма MAUI" FontSize="24" FontAttributes="Bold" />
            <Entry Placeholder="Введіть повне ім'я" Style="{StaticResource RoundedInput}" />
            <Editor Placeholder="Коротка біографія" AutoSize="TextChanges" HeightRequest="80" />
            <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                <CheckBox IsChecked="True" />
                <Label Text="Отримувати оновлення та сповіщення" VerticalOptions="Center" />
            </HorizontalStackLayout>
            <Slider Minimum="0" Maximum="20" Value="5" />
            <DatePicker />
            <Button Text="Підтвердити" Style="{StaticResource PrimaryActionBtn}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>