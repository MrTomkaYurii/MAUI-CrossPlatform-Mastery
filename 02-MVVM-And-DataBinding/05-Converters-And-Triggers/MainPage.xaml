<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:converters="clr-namespace:MauiMastery.ConvertersAndTriggers.Converters"
             x:Class="MauiMastery.ConvertersAndTriggers.MainPage"
             Title="Конвертери та тригери">
    <VerticalStackLayout Padding="20" Spacing="20">
        <!-- Entry з Property Trigger -->
        <Entry Placeholder="Введіть пароль (мін. 6 символів)">
            <Entry.Triggers>
                <Trigger TargetType="Entry" Property="IsFocused" Value="True">
                    <Setter Property="BackgroundColor" Value="#FEF3C7" />
                </Trigger>
            </Entry.Triggers>
        </Entry>

        <!-- Кнопка з Data Trigger -->
        <Button Text="Підтвердити операцію">
            <Button.Triggers>
                <DataTrigger TargetType="Button" Binding="{Binding IsBusy}" Value="True">
                    <Setter Property="IsEnabled" Value="False" />
                    <Setter Property="Text" Value="Обробка запиту..." />
                </DataTrigger>
            </Button.Triggers>
        </Button>
    </VerticalStackLayout>
</ContentPage>