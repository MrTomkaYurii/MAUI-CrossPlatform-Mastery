@code {
    private int currentCount = 0;

    private void IncrementCount()
    {
        currentCount++;
    }
}

<div class="card p-3 shadow-sm border-0">
    <h4 class="text-primary">Blazor компонент усередині нативного MAUI</h4>
    <p>Поточний рахунок: <strong>@currentCount</strong></p>
    <button class="btn btn-primary" @onclick="IncrementCount">Збільшити значення</button>
</div>